{
  "name": "rustwtm-site",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.2"
  },
  "scripts": {
    "dev": "next dev",
    "refresh:release": "node scripts/refresh-release.mjs",
